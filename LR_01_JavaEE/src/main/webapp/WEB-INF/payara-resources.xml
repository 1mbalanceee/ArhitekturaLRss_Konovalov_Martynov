<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE resources PUBLIC "-//Payara.fish//DTD Payara Server 4 Resource Definitions//EN" "https://raw.githubusercontent.com/payara/Payara-Server-Documentation/master/schemas/payara-resources_1_6.dtd">
<resources>
    <jdbc-connection-pool name="JewelryPool" datasource-classname="org.postgresql.ds.PGSimpleDataSource"
                          res-type="javax.sql.DataSource" steady-pool-size="2" max-pool-size="10"
                          max-wait-time-in-millis="10000" statement-timeout-in-seconds="15"
                          is-connection-validation-required="true" connection-validation-method="auto-commit">
        <property name="serverName" value="${ENV=DB_HOST}"/>
        <property name="portNumber" value="${ENV=DB_PORT}"/>
        <property name="databaseName" value="${ENV=DB_NAME}"/>
        <property name="user" value="${ENV=DB_USER}"/>
        <property name="password" value="${ENV=DB_PASSWORD}"/>
        <property name="connectTimeout" value="5"/>
        <property name="socketTimeout" value="30"/>
    </jdbc-connection-pool>
    <jdbc-resource jndi-name="java:app/jdbc/JewelryShop" pool-name="JewelryPool"/>
</resources>
